# Database
DATABASE_URL=postgresql://postgres:postgrespass@localhost:5432/goodreads_db

# Embedding (OpenAI)
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# LLM via OpenRouter
OPENROUTER_API_KEY=
LLM_MODEL=minimax/minimax-m2.5:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Reranker (Cohere)
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-english-v3.0
